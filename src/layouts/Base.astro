---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title: string; description: string; image?: string; lang?: 'en' | 'zh' }
const { title, description, image } = Astro.props;
const lang = Astro.props.lang ?? 'en';
---
<!doctype html>
<html lang={lang}><head><BaseHead title={title} description={description} image={image} /></head><body><div class="site-shell"><Header /><div class="site-main"><slot /><Footer /></div></div></body></html>
