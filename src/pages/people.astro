---
import Base from '../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../components/islands/PageBody.astro';
import { getConfig, getPage } from '../lib/data';
import { islands } from '../lib/islands';
const slug = 'people';
const result = await getPage(slug);
const data = result.data?.page;
const config = (await getConfig()).data?.config ?? null;
if (!data) return new Response('Not Found', { status: 404 });
---
<Base title={data.seoTitle || 'People | Peng Liu'} description={config?.seo?.description || ''}>
	<TinaIsland name="page" wrapper={islands.page.wrapper} params={{ slug }} primary><PageBody data={data} /></TinaIsland>
</Base>
