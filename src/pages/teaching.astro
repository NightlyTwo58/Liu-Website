---
import Base from '../layouts/Base.astro';
import InfoPage from '../components/InfoPage.astro';
const items = [{ label: 'Fall · ［Year］', title: '［Course number］ — ［Course title］', detail: '［Brief description, meeting information, and course site or syllabus link.］', link: '#' }, { label: 'Spring · ［Year］', title: '［Course number］ — ［Course title］', detail: '［Brief description, meeting information, and course site or syllabus link.］', link: '#' }, { label: 'Advising', title: 'Office hours and student support', detail: 'Office hours: ［day and time］, ［location］. Contact me by email to arrange another time.', link: 'mailto:name@university.edu' }];
---
<Base title="Teaching | ［Professor Name］" description="Current and recent courses taught by Professor ［Name］. Add syllabi, course sites, office hours, and advising information.">
	<main><InfoPage title="Teaching" eyebrow="Courses and advising" intro="Current and recent courses taught by Professor ［Name］. Add syllabi, course sites, office hours, and advising information." items={items} /></main>
</Base>
