---
import type { CmsPage } from '../../lib/data';
import { listPeople, listPublications } from '../../lib/data';
import PublicationArchive from '../PublicationArchive.astro';
interface Props { data?: CmsPage | null }
const { data } = Astro.props;
const people = data?._sys.filename === 'people' ? await listPeople() : [];
const publications = ['home', 'publications'].includes(data?._sys.filename ?? '') ? await listPublications() : [];
const slug = data?._sys.filename ?? '';
const copy: Record<string, { eyebrow: string; title: string; intro: string; items?: { label: string; title: string; detail: string; link?: string; linkText?: string }[] }> = {
 about: { eyebrow: '研究与个人经历', title: '关于 Peng Liu', intro: '我的研究关注金融市场如何影响实体经济中的决策，尤其研究实体资产的估值、融资与资本配置。', items: [
  { label: '研究视角', title: '实体资产与资本市场', detail: '我的研究涉及房地产金融、酒店业、证券化和大宗商品市场，关注估值、投资、融资选择、风险以及信息和市场结构的影响。' },
  { label: '学术生涯之前', title: '金融与咨询经历', detail: '进入学术界之前，我曾在纽约的 Goldman Sachs Asset Management 和北京的 Deloitte Consulting 工作，之后在加州大学伯克利分校 Fisher Center for Real Estate and Urban Economics 担任研究员五年。' },
  { label: '教育背景', title: '加州大学伯克利分校、北京大学与清华大学', detail: '我在加州大学伯克利分校（University of California, Berkeley）获得房地产与金融学博士学位及金融学硕士学位，在北京大学（Peking University）获得金融经济学硕士学位，并在清华大学（Tsinghua University）获得工学学士学位。' },
  { label: '学术服务', title: '房地产与酒店业研究', detail: '我担任 Journal of Real Estate Portfolio Management 主编，并参与房地产、金融和酒店业相关期刊及研究组织的学术服务。' },
  { label: '学生咨询', title: '研究机会与申请', detail: '研究助理机会取决于当前项目。欢迎通过电子邮件介绍您的研究兴趣、相关经历并附上简历。研究生申请由康奈尔大学相关项目负责。', link: '/zh/students', linkText: '学生信息' },
 ] },
 students: { eyebrow: '', title: '学生咨询', intro: '研究助理名额视项目需求而定。如需咨询，请通过电子邮件联系 Peng Liu，并附上研究兴趣、相关经历和简历。研究生申请请直接联系康奈尔大学相关项目。' },
 teaching: { eyebrow: '', title: '教学', intro: '', items: [
  { label: '2026年春季', title: 'Principles of Real Estate · HADM 6200', detail: '研究生课程', link: 'https://classes.cornell.edu/browse/roster/SP26/class/HADM/6200', linkText: '课程表' },
 ] },
 cv: { eyebrow: '个人经历、荣誉与学术服务', title: '简历与学术服务', intro: '包括教育背景、学术任职、研究领导工作、期刊编辑服务及部分荣誉。康奈尔大学个人简历于 2025 年 12 月更新，涵盖完整的论文与职业经历。', items: [
  { label: '2023年至今', title: '房地产与金融学正教授', detail: '康奈尔大学约翰逊商学院；应用经济与政策及金融学。' },
  { label: '2023年至今', title: 'Paul Rubacha 房地产系创系教师', detail: '康奈尔大学。' },
  { label: '2013–2023', title: '房地产与金融学副教授（终身教职）', detail: '康奈尔大学。' },
  { label: '2007–2013', title: '房地产学助理教授', detail: '康奈尔大学诺兰酒店管理学院。' },
  { label: '2002–2007', title: '研究员', detail: '加州大学伯克利分校 Fisher Center for Real Estate and Urban Economics。' },
  { label: '早期职业经历', title: '行业经验', detail: 'Goldman Sachs Asset Management 与 Deloitte Consulting（北京）。' },
  { label: '2023年至今', title: '康奈尔大学–北京大学 MMH/MBA 双学位项目主任', detail: '负责该双学位项目的学术工作。' },
  { label: '2025年至今', title: '房地产与金融中心主任', detail: '担任康奈尔大学约翰逊房地产与金融中心主任。' },
  { label: '2025年至今', title: '应用经济与政策领域副主任', detail: '康奈尔大学。' },
  { label: '2019年至今', title: '房地产辅修项目协调人', detail: '康奈尔大学。' },
  { label: '2024', title: 'American Real Estate Society 论文奖', detail: '企业房地产研究最佳论文奖，由 CoreNet Global 赞助。' },
  { label: '2022', title: 'INFORMS Society 长期影响力奖', detail: '入围决选。' },
  { label: '2019', title: '房地产新星奖', detail: '上海。' },
  { label: '2016年至今', title: '新加坡旅游局亚洲酒店管理杰出教授', detail: '康奈尔大学诺兰酒店管理学院。' },
  { label: '2014', title: 'William N. Kinnard 学者', detail: 'American Real Estate Society。' },
  { label: '2014', title: 'Homer Hoyt 博士后荣誉奖', detail: 'Weimer School of Advanced Studies in Real Estate and Land Economics。' },
  { label: '2006', title: '最佳研究生讲师', detail: '加州大学伯克利分校哈斯商学院。' },
  { label: '2011、2012、2018、2019、2024', title: 'American Real Estate Society 论文奖', detail: '获奖研究涉及零售房地产、CoStar 数据、投资组合管理及企业房地产。' },
  { label: '2007', title: '房地产与金融学博士', detail: '加州大学伯克利分校哈斯商学院。' },
  { label: '2007', title: '金融学硕士', detail: '加州大学伯克利分校哈斯商学院。' },
  { label: '2000', title: '金融经济学硕士', detail: '北京大学。' },
  { label: '1994', title: '工学学士', detail: '清华大学。' },
  { label: '2014年至今', title: 'Journal of Real Estate Portfolio Management 主编', detail: '自 2014 年起担任主编。' },
  { label: '副主编', title: '期刊学术服务', detail: 'Journal of Real Estate Research、International Real Estate Review、Journal of Commodity Markets。' },
  { label: '编委', title: 'Cornell Hospitality Quarterly', detail: '期刊编委。' },
  { label: '期刊服务', title: '其他编辑职务', detail: '曾任 Cornell Hospitality Quarterly 副主编（2014–2015）；并担任 Journal of Real Estate Research、Tourism Tribune、Cornell Hospitality Quarterly、Economic and Political Studies 及《房地产》编委。' },
  { label: '2018–2019', title: '副主席', detail: 'Western Finance Association 第 54 届年会委员会。' },
 ] },
 publications: { eyebrow: '论文、著作、章节与案例', title: '学术成果', intro: 'Peng Liu 与合作者发表的期刊论文、书籍与章节、案例及工作论文。论文标题、出版信息和引文保留英文。' },
 people: { eyebrow: '房地产 · 金融 · 酒店业', title: '研究团队', intro: '教师与研究团队成员介绍。' },
};
const page = copy[slug];
const home = slug === 'home';
---
{data && (home ? <div class="liu-home zh-home">
 <header class="liu-home__topbar"><div class="liu-home__wrap"><a class="liu-home__wordmark" href="/zh">Peng (Peter) Liu</a><nav aria-label="主导航"><a href="#about">关于</a><a href="#research">研究</a><a href="#teaching">教学</a><a href="#contact">联系</a><a href="/zh/publications">学术成果</a><a href="/">English</a></nav></div></header>
 <main>
  <section class="liu-home__hero" id="top"><div class="liu-home__wrap"><img class="liu-home__portrait" src="/peter.jpg" alt="Peng (Peter) Liu" /><div><h1>Peng (Peter) Liu</h1><p class="liu-home__role">房地产与金融学正教授</p><p class="liu-home__unit">新加坡旅游局亚洲酒店管理杰出教授<br />诺兰酒店管理学院 · 康奈尔大学约翰逊商学院</p><div class="liu-home__actions"><a class="liu-home__button liu-home__button--primary" href="https://apps.business.cornell.edu/faculty-research/faculty/vita/pl333">个人简历</a><a class="liu-home__button" href="mailto:pl333@cornell.edu">pl333@cornell.edu</a><a class="liu-home__button" href="https://business.cornell.edu/profiles/pl333/">康奈尔个人主页</a></div></div></div></section>
  <section class="liu-home__section" id="about"><div class="liu-home__wrap liu-home__intro"><div><h2>关于</h2><p>Peng (Peter) Liu 是康奈尔大学诺兰酒店管理学院房地产与金融学教授，也是 Rubacha 房地产系创系教师。他的研究关注金融市场如何影响实体经济决策，尤其关注实体资产的估值、融资与资本配置。</p><p>他负责康奈尔大学与北京大学 MMH/MBA 双学位项目，并担任康奈尔房地产与金融中心研究主任。</p><ul class="liu-home__interests"><li>房地产金融</li><li>REITs</li><li>酒店资产市场</li><li>CMBS 与证券化</li><li>大宗商品</li><li>应用计量经济学</li></ul></div><aside class="liu-home__news"><h3>近期动态</h3><ol><li><time>2026 春</time><span>教授 HADM 6200《房地产原理》。</span></li><li><time>2025 年 7 月</time><span>出任房地产与金融中心研究主任。</span></li><li><time>2025 年</time><span>《酒店财务管理与情境化决策》第二版出版。</span></li></ol></aside></div></section>
  <section class="liu-home__section" id="research"><div class="liu-home__wrap"><div class="liu-home__section-head"><div><h2>精选研究</h2><p>关于实体资产估值、融资与经营的近期研究。</p></div><a href="/zh/publications">查看全部学术成果</a></div><div class="liu-home__research-grid">{publications.slice(0, 6).map((publication) => <article><p class="liu-home__publication-meta">{publication.year} · {publication.journal || publication.category}</p><h3><a href={`/zh/publications/${publication._sys.filename}`}>{publication.title}</a></h3><p>{publication.authors}</p></article>)}</div></div></section>
  <section class="liu-home__section" id="teaching"><div class="liu-home__wrap"><div class="liu-home__section-head"><div><h2>教学</h2><p>房地产、金融与酒店业交叉领域的课程和项目。</p></div><a href="/zh/teaching">全部课程</a></div><div class="liu-home__course-grid"><article><span>HADM 6200</span><h3>房地产原理</h3><p>房地产市场、投资与金融导论。</p></article><article><span>MBA</span><h3>房地产金融</h3><p>实体资产的资本市场与金融决策。</p></article><article><span>MMH/MBA</span><h3>康奈尔—北京大学双学位</h3><p>参与联合酒店管理与商学项目的学术工作。</p></article></div></div></section>
 </main><footer class="liu-home__contact" id="contact"><div class="liu-home__wrap"><div><dt>办公室</dt><dd>448 Statler Hall<br />Ithaca, NY 14853-6201</dd></div><div><dt>电子邮件</dt><dd><a href="mailto:pl333@cornell.edu">pl333@cornell.edu</a></dd></div><div><dt>电话</dt><dd>607.254.2960</dd></div><div><dt>学术主页</dt><dd><a href="https://scholar.google.com/citations?user=v1zHGQEAAAAJ&hl=en">Google Scholar</a><br /><a href="https://ecommons.cornell.edu/browse/author?value=Liu,%20Peng">eCommons</a></dd></div></div><p class="liu-home__copyright liu-home__wrap">© {new Date().getFullYear()} Peng (Peter) Liu · 康奈尔大学</p></footer>
</div> : page ? <main class="page-shell info-page zh-page compact-page">
 <h1>{page.title}</h1>
 {slug === 'about' ? <>
  {(page.items ?? []).map((item) => (
   <p class="about-prose"><strong>{item.title}。</strong>{item.detail} {item.link && <a href={item.link}>{item.linkText || '详情'}</a>}</p>
  ))}
  <section class="overview-updates"><h2>近期动态</h2><ul><li><time>2025</time><span>论文 “The Influence of Hotel Characteristics on Debt Servicing and Default in the U.S. Lodging Sector” 发表于 <em>Cornell Hospitality Quarterly</em>, 66(2), 137–155。</span></li><li><time>2025</time><span>论文 “Founder CEOs and REIT Capital Structure” 发表于 <em>Journal of Real Estate Research</em>。</span></li><li><time>2024</time><span>论文 “Investor Networks and Fund Performance in Private Equity Real Estate Funds” 发表于 <em>Journal of Real Estate Finance and Economics</em>。</span></li></ul></section>
 </> : null}
 {slug === 'publications' ? <PublicationArchive publications={publications} lang="zh" /> : null}
 {slug === 'students' ? <p class="single-paragraph">{page.intro}</p> : null}
 {slug === 'teaching' ? <div class="compact-record-list">{(page.items ?? []).map((item) => <article class="compact-record"><span class="compact-year">{item.label}</span><div><h2><a href={item.link}>{item.title}</a></h2><p class="compact-detail">{item.detail}</p></div></article>)}</div> : null}
 {slug === 'people' ? <div class="people-grid">{people.map((person) => <article class="person-card"><a class="person-photo" href={`/zh/people/${person._sys.filename}`} aria-label={`查看 ${person.name} 介绍`}>{person.photo && <img src={person.photo} alt={person.name} />}</a><div><p class="compact-meta">{person.role?.includes('Professor of Real Estate and Finance') ? '房地产与金融学教授' : person.role}</p><h2><a href={`/zh/people/${person._sys.filename}`}>{person.name}</a></h2>{person.researchArea && <p class="compact-detail">{person.researchArea}</p>}</div></article>)}</div> : null}
 {slug === 'cv' ? <p class="zh-inline-links"><a href="https://apps.business.cornell.edu/faculty-research/faculty/vita/pl333">打开英文完整简历（2025年12月更新）</a><a href="https://business.cornell.edu/profiles/pl333/">康奈尔英文个人主页</a></p> : null}
</main> : null)}
