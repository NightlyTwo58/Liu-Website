---
import Blocks from '../blocks/Blocks.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsPage } from '../../lib/data';
import { listPeople, listPublications } from '../../lib/data';
import PublicationArchive from '../PublicationArchive.astro';

interface Props { data?: CmsPage | null }
const { data } = Astro.props;
const people = data?._sys.filename === 'people' ? await listPeople() : [];
const publicationRecords = ['home', 'publications'].includes(data?._sys.filename ?? '') ? await listPublications() : [];
const featuredSlugs = ['cmbs-pricing-liquidity-risk', 'residential-brokerage-contract-design', 'commodity-futures-returns'];
const featuredPublications = publicationRecords.filter((publication) => featuredSlugs.includes(publication._sys.filename));
function isPresent<T>(value: T | null | undefined): value is T { return value !== null && value !== undefined; }
---
{data?.pageType === 'homepage' ? (
	<div class="liu-home">
		<header class="liu-home__topbar"><div class="liu-home__wrap"><a class="liu-home__wordmark" href="#top">Peng (Peter) Liu</a><nav aria-label="Sections"><a href="#about">About</a><a href="#research">Research</a><a href="#teaching">Teaching</a><a href="#contact">Contact</a><a href="/publications">Publications</a><a href="/zh">中文</a></nav></div></header>
		<main>
			<section class="liu-home__hero" id="top"><div class="liu-home__wrap"><img class="liu-home__portrait" src="/peter.jpg" alt="Peng (Peter) Liu" /><div><h1>Peng (Peter) Liu</h1><p class="liu-home__role">Professor of Real Estate and Finance</p><p class="liu-home__unit">Singapore Tourism Board Distinguished Professor in Asian Hospitality Management<br />Nolan School of Hotel Administration · Cornell SC Johnson College of Business</p><div class="liu-home__actions"><a class="liu-home__button liu-home__button--primary" href="https://apps.business.cornell.edu/faculty-research/faculty/vita/pl333">Curriculum vitae</a><a class="liu-home__button" href="mailto:pl333@cornell.edu">pl333@cornell.edu</a><a class="liu-home__button" href="https://business.cornell.edu/profiles/pl333/">Cornell profile</a></div></div></div></section>
			<section class="liu-home__section" id="about"><div class="liu-home__wrap liu-home__intro"><div><h2>About</h2><p data-tina-field={tinaField(data, 'researchSummary')}>Peng (Peter) Liu is Professor of Real Estate and Finance at Cornell’s Nolan School of Hotel Administration and an inaugural faculty member of the Rubacha Department of Real Estate. {data.researchSummary}</p><p>He directs the Cornell–Peking University MMH/MBA dual degree and serves as Faculty Research Director of the Cornell SC Johnson Center for Real Estate and Finance. His work focuses on how financial markets value and finance real assets.</p><ul class="liu-home__interests"><li>Real estate finance</li><li>REITs</li><li>Hotel asset markets</li><li>CMBS &amp; securitization</li><li>Commodities</li><li>Applied econometrics</li></ul></div><aside class="liu-home__news" aria-labelledby="home-news"><h3 id="home-news">News</h3><ol><li><time>Spr 2026</time><span>Teaching HADM 6200, Principles of Real Estate.</span></li><li><time>Jul 2025</time><span>Named Faculty Research Director, Center for Real Estate and Finance.</span></li><li><time>Jul 2025</time><span>Appointed Deputy Area Chair, Applied Economics and Policy.</span></li><li><time>2025</time><span>Second edition of <em>Hospitality Financial Management and Contextualized Decision Making</em> published.</span></li></ol></aside></div></section>
			<section class="liu-home__section" id="research"><div class="liu-home__wrap"><div class="liu-home__section-head"><div><h2>Selected research</h2><p>Recent work on the valuation, financing, and operation of real assets.</p></div><a href="/publications">View all publications</a></div><div class="liu-home__research-grid">{publicationRecords.slice(0, 6).map((publication) => <article><p class="liu-home__publication-meta">{publication.year} · {publication.journal || publication.category}</p><h3><a href={`/publications/${publication._sys.filename}`}>{publication.title}</a></h3><p>{publication.authors}</p></article>)}</div></div></section>
			<section class="liu-home__section" id="teaching"><div class="liu-home__wrap"><div class="liu-home__section-head"><div><h2>Teaching</h2><p>Courses and programs at the intersection of finance, real estate, and hospitality.</p></div><a href="/teaching">All teaching</a></div><div class="liu-home__course-grid"><article><span>HADM 6200</span><h3>Principles of Real Estate</h3><p>An introduction to real estate markets, investment, and finance.</p></article><article><span>MBA</span><h3>Real Estate Finance</h3><p>Capital markets and financial decision-making for real assets.</p></article><article><span>MMH/MBA</span><h3>Cornell–Peking University dual degree</h3><p>Academic leadership for the joint hospitality and business program.</p></article></div></div></section>
		</main>
		<footer class="liu-home__contact" id="contact"><div class="liu-home__wrap"><div><dt>Office</dt><dd>448 Statler Hall<br />Ithaca, NY 14853-6201</dd></div><div><dt>Email</dt><dd><a href="mailto:pl333@cornell.edu">pl333@cornell.edu</a></dd></div><div><dt>Phone</dt><dd>607.254.2960</dd></div><div><dt>Profiles</dt><dd><a href="https://scholar.google.com/citations?user=v1zHGQEAAAAJ&hl=en">Google Scholar</a><br /><a href="https://ecommons.cornell.edu/browse/author?value=Liu,%20Peng">eCommons</a></dd></div></div><p class="liu-home__copyright liu-home__wrap">© {new Date().getFullYear()} Peng (Peter) Liu · Cornell University</p></footer>
	</div>
) : data?.pageType === 'cv' ? (
	<main class="page-shell info-page cv-page">
		<p class="eyebrow" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p><h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1><p class="lead page-lead" data-tina-field={tinaField(data, 'intro')}>{data.intro}</p>
		<section class="cv-materials" aria-label="CV and professional profile"><article class="cv-document"><div><p class="row-label">Curriculum vitae</p><h2>Peng Liu — CV</h2><p data-tina-field={tinaField(data, 'cvUpdated')}>{data.cvUpdated} · PDF</p></div><a class="document-link" href={data.cvPdf} target="_blank" rel="noopener">Open or download CV</a></article><article class="cv-document statement-document"><div><p class="row-label">Professional profile</p><h2 data-tina-field={tinaField(data, 'statementTitle')}>{data.statementTitle}</h2><p data-tina-field={tinaField(data, 'statementText')}>{data.statementText}</p></div>{data.statementUrl && <a href={data.statementUrl}>Cornell profile</a>}</article></section>
	</main>
) : data?._sys.filename === 'people' ? (
	<main class="page-shell info-page compact-page"><h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1><div class="people-grid">{people.map((person) => <article class="person-card"><a class="person-photo" href={`/people/${person._sys.filename}`} aria-label={`View ${person.name} profile`}>{person.photo && <img src={person.photo} alt={person.name} />}</a><div><p class="compact-meta">{person.role}</p><h2><a href={`/people/${person._sys.filename}`}>{person.name}</a></h2>{person.researchArea && <p class="compact-detail">{person.researchArea}</p>}</div></article>)}</div></main>
) : data?._sys.filename === 'publications' ? (
	<main class="page-shell info-page publications-page"><h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1><PublicationArchive publications={publicationRecords} lang="en" /></main>

) : data?._sys.filename === 'students' ? (
	<main class="page-shell info-page compact-page"><h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1><p class="single-paragraph" data-tina-field={tinaField(data, 'intro')}>{data.intro}</p></main>
) : data?._sys.filename === 'teaching' ? (
	<main class="page-shell info-page compact-page"><h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1><div class="compact-record-list">{(data.items ?? []).filter(isPresent).map((item) => <article class="compact-record"><span class="compact-year">{item.label}</span><div><h2>{item.link ? <a href={item.link}>{item.title}</a> : item.title}</h2><p class="compact-detail">{item.detail}</p></div></article>)}</div></main>
) : data?._sys.filename === 'about' ? (
	<main class="page-shell info-page about-page"><h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1><p class="about-prose" data-tina-field={tinaField(data, 'intro')}>{data.intro}</p>
		{data.items?.filter(isPresent).map((item) => <p class="about-prose"><strong>{item.title}.</strong> {item.detail} {item.link && <a href={item.link}>{item.linkText || 'Details'}</a>}</p>)}
		{data.updates?.length ? <section class="overview-updates" aria-labelledby="about-updates-heading"><h2 id="about-updates-heading">Recent news</h2><ul>{data.updates.filter(isPresent).map((update) => <li><time>{update.date}</time><span>{update.text}</span></li>)}</ul></section> : null}
	</main>
) : data?.pageType === 'listing' ? (
	<main class="page-shell info-page"><p class="eyebrow" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p><h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1><p class="lead page-lead" data-tina-field={tinaField(data, 'intro')}>{data.intro}</p><div class="info-list">{(data.items ?? []).filter(isPresent).map((item, index) => <article class="info-row"><span class="row-number">{String(index + 1).padStart(2, '0')}</span><div><p class="row-label" data-tina-field={tinaField(item, 'label')}>{item.label}</p><h2 data-tina-field={tinaField(item, 'title')}>{item.title}</h2><p data-tina-field={tinaField(item, 'detail')}>{item.detail}</p></div>{item.link && <a href={item.link} data-tina-field={tinaField(item, 'link')}>{item.linkText || 'Details'}</a>}</article>)}</div></main>
) : data ? <Blocks data={data} /> : null}
